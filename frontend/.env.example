# Copia este archivo como .env.local y ajusta los valores
# .env.local es ignorado por git

# Apuntar a AWS dev desde el browser local (en vez del servidor uvicorn)
# Descomenta la línea de abajo para usar la API de AWS dev directamente:
# EXPO_PUBLIC_API_URL=https://api-billing-dev.codelabsecuador.com

# Apuntar al servidor local (default cuando no está definida la variable)
# EXPO_PUBLIC_API_URL=http://localhost:8000
