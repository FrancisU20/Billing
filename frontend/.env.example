# Copia este archivo como .env.local y ajusta los valores
# .env.local es ignorado por git

# Default en desarrollo: AWS dev.
# Descomenta y ajusta solo si necesitas apuntar a otro endpoint.
# EXPO_PUBLIC_API_URL=https://api-wali-dev.codelabsecuador.com

# SmartFields key de dLocal Go. Usar key de sandbox en dev/staging, produccion en prod.
# Obtener desde el dashboard de dLocal Go bajo el entorno correspondiente.
EXPO_PUBLIC_DLOCALGO_SMARTFIELDS_KEY=
