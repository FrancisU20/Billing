# ─────────────────────────────────────────────────────────────
# CodeLabs Billing — variables de entorno para desarrollo local
# Copia este archivo como .env y ajusta los valores
# ─────────────────────────────────────────────────────────────

# ── Identidad del usuario simulado ────────────────────────────
# Cambia estos valores según el rol que quieras testear

# Superadmin (puede crear tenants, listar todos, etc.)
LOCAL_USER_ID=superadmin-local-1
LOCAL_EMAIL=superadmin@codelabs.com
LOCAL_ROLE=superadmin
LOCAL_IS_SUPERADMIN=true
LOCAL_TENANT_ID=

# Para testear como owner/admin de un tenant, reemplaza con valores reales:
# LOCAL_USER_ID=owner-local-1
# LOCAL_EMAIL=owner@empresa.com
# LOCAL_ROLE=owner
# LOCAL_IS_SUPERADMIN=false
# LOCAL_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── DynamoDB — tablas AWS dev (credenciales de ~/.aws/credentials) ──
# Las tablas las gestiona CDK: make deploy
TENANTS_TABLE=codelabs-billing-dev-tenants
CLIENTS_TABLE=codelabs-billing-dev-clients
USERS_TABLE=codelabs-billing-dev-users
AUDIT_LOG_TABLE=codelabs-billing-dev-audit
IDEMPOTENCY_TABLE=codelabs-billing-dev-idempotency
# Si se configura, los writes locales generan outbox en AWS dev y disparan
# el stream/worker desplegado. Déjalo vacío para evitar side effects async.
OUTBOX_TABLE=codelabs-billing-dev-outbox
MIGRATIONS_TABLE=codelabs-billing-dev-migrations

# ── Cognito — llenar después de: make deploy ──────────────────
# Los valores se encuentran en los outputs del stack Auth:
# aws cloudformation describe-stacks --stack-name CodeLabsBilling-Dev-Auth \
#   --query 'Stacks[0].Outputs' --profile codelabs --region sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=

# ── Queues SQS ─────────────────────────────────────────────────
# Vacío en local — los eventos se loguean pero no se envían a SQS
EVENTS_QUEUE_URL=

# ── Aplicación ─────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=DEBUG
AWS_REGION=sa-east-1
AWS_DEFAULT_REGION=sa-east-1

# ── Servidor local ─────────────────────────────────────────────
LOCAL_PORT=8080
LOCAL_RUN_WORKERS_INLINE=false
