{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Debug API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env.local",
      "preLaunchTask": "open-aurora",
      "postDebugTask": "close-aurora",
      "justMyCode": false,
      "jinja": true
    },
    {
      "name": "⚡ Debug Invoice Worker",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/local/scripts/run_lambda.py",
      "args": [
        "lambda_handlers.invoice_worker_handler.handler",
        "${workspaceFolder}/local/events/invoice_worker.json"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env.local",
      "preLaunchTask": "open-aurora",
      "postDebugTask": "close-aurora",
      "justMyCode": false
    },
    {
      "name": "📧 Debug Email Dispatch",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/local/scripts/run_lambda.py",
      "args": [
        "lambda_handlers.email_dispatch_handler.handler",
        "${workspaceFolder}/local/events/email_dispatch.json"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env.local",
      "preLaunchTask": "open-aurora",
      "postDebugTask": "close-aurora",
      "justMyCode": false
    },
    {
      "name": "🏢 Debug Tenant Onboarding",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/local/scripts/run_lambda.py",
      "args": [
        "lambda_handlers.tenant_onboarding_handler.handler",
        "${workspaceFolder}/local/events/tenant_onboarding.json"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env.local",
      "preLaunchTask": "open-aurora",
      "postDebugTask": "close-aurora",
      "justMyCode": false
    },
    {
      "name": "🔄 Debug SRI Retry",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/local/scripts/run_lambda.py",
      "args": [
        "lambda_handlers.sri_retry_handler.handler",
        "${workspaceFolder}/local/events/sri_retry.json"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env.local",
      "preLaunchTask": "open-aurora",
      "postDebugTask": "close-aurora",
      "justMyCode": false
    }
  ]
}
