{
  "info": {
    "name": "CodeLabs Billing Cloud",
    "_postman_id": "clb-collection-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Crear Tenant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruc\": \"1003368725001\",\n  \"trade_name\": \"CodeLabs Ecuador\",\n  \"legal_rep_name\": \"Francisco Mateo Ulloa Teran\",\n  \"email\": \"panchoulloateran@gmail.com\",\n  \"phone\": \"0968567684\",\n  \"address\": \"Asunción Oe5-101 y Estados Unidos\",\n  \"plan_id\": \"b7346eba-6e10-4b9c-bc45-9ea1b126844f\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/tenants", "host": ["{{base_url}}"], "path": ["tenants"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('201', () => pm.response.to.have.status(201));",
                "const body = pm.response.json();",
                "pm.test('success', () => pm.expect(body.success).to.be.true);",
                "pm.environment.set('tenant_id', body.data.id);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Listar Tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tenants?limit=20",
              "host": ["{{base_url}}"],
              "path": ["tenants"],
              "query": [
                { "key": "limit",      "value": "20" },
                { "key": "next_token", "value": "", "disabled": true },
                { "key": "status",     "value": "active", "disabled": true }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('paginado', () => pm.expect(body.data).to.have.property('items'));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Ver Tenant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tenants/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["tenants", "{{tenant_id}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('id correcto', () => pm.expect(body.data.id).to.eql(pm.environment.get('tenant_id')));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Actualizar Tenant",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trade_name\": \"CodeLabs Ecuador Actualizado\",\n  \"email\": \"nuevo@codelabs.ec\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/tenants/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["tenants", "{{tenant_id}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "pm.test('version incrementada', () => pm.expect(pm.response.json().data.version).to.be.greaterThan(1));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Cambiar Estado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"suspended\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/tenants/{{tenant_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["tenants", "{{tenant_id}}", "status"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Eliminar Tenant",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": {
              "raw": "{{base_url}}/tenants/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["tenants", "{{tenant_id}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('204', () => pm.response.to.have.status(204));"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "Listar Plans",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/plans",
              "host": ["{{base_url}}"],
              "path": ["plans"],
              "query": [
                { "key": "active_only", "value": "true", "disabled": true }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('lista', () => pm.expect(body.data).to.be.an('array'));",
                "if (body.data.length > 0) pm.environment.set('plan_id', body.data[0].id);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Ver Plan por Slug",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/plans/free",
              "host": ["{{base_url}}"],
              "path": ["plans", "free"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "pm.test('slug', () => pm.expect(pm.response.json().data.slug).to.eql('free'));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Crear Plan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"starter\",\n  \"name\": \"Starter\",\n  \"description\": \"Plan de inicio para pequeños negocios\",\n  \"monthly_price\": \"15.00\",\n  \"annual_price\": \"150.00\",\n  \"document_limit\": 100,\n  \"limit_cycle\": \"month\",\n  \"max_locations\": 1,\n  \"max_emission_points\": 2,\n  \"max_users\": 3,\n  \"includes_credit_notes\": true,\n  \"includes_withholdings\": true,\n  \"includes_delivery_notes\": false,\n  \"includes_api\": false,\n  \"order\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/plans", "host": ["{{base_url}}"], "path": ["plans"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('201', () => pm.response.to.have.status(201));",
                "const body = pm.response.json();",
                "pm.test('success', () => pm.expect(body.success).to.be.true);",
                "pm.environment.set('plan_id', body.data.id);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Actualizar Plan",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Starter Actualizado\",\n  \"monthly_price\": \"19.00\",\n  \"document_limit\": 150\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/plans/{{plan_id}}",
              "host": ["{{base_url}}"],
              "path": ["plans", "{{plan_id}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "pm.test('version incrementada', () => pm.expect(pm.response.json().data.version).to.be.greaterThan(1));"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Activar / Desactivar Plan",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/plans/{{plan_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["plans", "{{plan_id}}", "status"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    }
  ]
}
