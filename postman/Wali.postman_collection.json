{
	"info": {
		"name": "Wali",
		"_postman_id": "clb-collection-001",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"description": "Rutas públicas de autenticación. Login usa Cognito USER_SRP_AUTH desde Lambda; el frontend nunca llama Cognito directamente. El ID token se guarda como {{token}} porque contiene los custom claims del tenant y rol.",
			"item": [
				{
					"name": "Login",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"password\": \"{{auth_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica con SRP vía backend. Responde tokens o challenge pendiente, por ejemplo NEW_PASSWORD_REQUIRED."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('success', () => pm.expect(body.success).to.be.true);",
									"if (body.data.id_token) {",
									"  pm.environment.set('id_token', body.data.id_token);",
									"  pm.environment.set('token', body.data.id_token);",
									"}",
									"if (body.data.access_token) pm.environment.set('access_token', body.data.access_token);",
									"if (body.data.refresh_token) pm.environment.set('refresh_token', body.data.refresh_token);",
									"if (body.data.challenge_name) pm.environment.set('auth_challenge_name', body.data.challenge_name);",
									"if (body.data.session) pm.environment.set('auth_session', body.data.session);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Refresh",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						},
						"description": "Renueva ID/access token con el refresh token emitido por Cognito."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('success', () => pm.expect(body.success).to.be.true);",
									"if (body.data.id_token) {",
									"  pm.environment.set('id_token', body.data.id_token);",
									"  pm.environment.set('token', body.data.id_token);",
									"}",
									"if (body.data.access_token) pm.environment.set('access_token', body.data.access_token);",
									"if (body.data.refresh_token) pm.environment.set('refresh_token', body.data.refresh_token);",
									"if (body.data.challenge_name) pm.environment.set('auth_challenge_name', body.data.challenge_name);",
									"if (body.data.session) pm.environment.set('auth_session', body.data.session);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"access_token\": \"{{access_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"logout"
							]
						},
						"description": "Cierra sesión globalmente en Cognito usando el access token enviado en el body."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('204', () => pm.response.to.have.status(204));",
									"const body = pm.response.json();",
									"pm.test('success', () => pm.expect(body.success).to.be.true);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Challenge - NEW_PASSWORD_REQUIRED",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"session\": \"{{auth_session}}\",\n  \"challenge_name\": \"NEW_PASSWORD_REQUIRED\",\n  \"responses\": {\n    \"USERNAME\": \"{{auth_username}}\",\n    \"NEW_PASSWORD\": \"{{auth_new_password}}\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/challenge",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"challenge"
							]
						},
						"description": "Completa el challenge NEW_PASSWORD_REQUIRED. También sirve como plantilla para futuros challenges cambiando challenge_name y responses."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('success', () => pm.expect(body.success).to.be.true);",
									"if (body.data.id_token) {",
									"  pm.environment.set('id_token', body.data.id_token);",
									"  pm.environment.set('token', body.data.id_token);",
									"}",
									"if (body.data.access_token) pm.environment.set('access_token', body.data.access_token);",
									"if (body.data.refresh_token) pm.environment.set('refresh_token', body.data.refresh_token);",
									"if (body.data.challenge_name) pm.environment.set('auth_challenge_name', body.data.challenge_name);",
									"if (body.data.session) pm.environment.set('auth_session', body.data.session);"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
